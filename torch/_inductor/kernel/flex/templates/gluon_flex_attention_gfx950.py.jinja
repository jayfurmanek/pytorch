{{def_kernel("Q", "K", "V", "LSE", "MAX", "KV_NUM_BLKS", "KV_IDX", "FULL_KV_NUM_BLKS", "FULL_KV_IDX")}}
    gl.static_assert(SPARSE_Q_BLOCK_SIZE >= BLOCK_M and SPARSE_Q_BLOCK_SIZE % BLOCK_M == 0)
    gl.static_assert(SPARSE_KV_BLOCK_SIZE >= BLOCK_N and SPARSE_KV_BLOCK_SIZE % BLOCK_N == 0)
    gl.static_assert(QK_HEAD_DIM == V_HEAD_DIM)

    stride_qz, stride_qh, stride_qm, stride_qk = {{stride("Q")}}
    stride_kz, stride_kh, stride_kn, stride_kk = {{stride("K")}}
    stride_vz, stride_vh, stride_vn, stride_vk = {{stride("V")}}

    ZQ = {{size("Q", 0)}}
    HQ = {{size("Q", 1)}}
    Q_LEN = {{size("Q", 2)}}
    ZKV = {{size("K", 0)}}
    KV_LEN = {{size("K", 2)}}

    RCP_LN2: gl.constexpr = 1.44269504
    HEAD_DIM: gl.constexpr = QK_HEAD_DIM
    MFMA: gl.constexpr = gl.amd.AMDMFMALayout(
        version=4, instr_shape=[32, 32, 16], transposed=True, warps_per_cta=[gl.num_warps(), 1]
    )
    Q_DOT: gl.constexpr = gl.DotOperandLayout(0, MFMA, k_width=8)
    K_DOT: gl.constexpr = gl.DotOperandLayout(1, MFMA, k_width=8)
    P_DOT: gl.constexpr = gl.DotOperandLayout(0, MFMA, k_width=4)
    V_DOT: gl.constexpr = gl.DotOperandLayout(1, MFMA, k_width=4)
    # 8 x 16-bit elements per lane (128-bit loads); a row of HEAD_DIM spans HEAD_DIM // 8 lanes.
    LOAD: gl.constexpr = gl.BlockedLayout(
        [1, 8], [64 // (HEAD_DIM // 8), HEAD_DIM // 8], [gl.num_warps(), 1], [1, 0]
    )
    K_SMEM: gl.constexpr = padded_shared_layout(K_DOT, [BLOCK_N, HEAD_DIM], K.dtype.element_ty, True)
    V_SMEM: gl.constexpr = padded_shared_layout(V_DOT, [BLOCK_N, HEAD_DIM], V.dtype.element_ty, False)
    ROW: gl.constexpr = gl.SliceLayout(1, MFMA)
    COL: gl.constexpr = gl.SliceLayout(0, MFMA)

    q_start = gl.program_id(0).to(INDEX_DTYPE)
    off_zq = gl.program_id(1).to(INDEX_DTYPE)
    off_hq = gl.program_id(2).to(INDEX_DTYPE)
    off_zkv = off_zq % ZKV
    off_hkv = off_hq // GQA_SHARED_HEADS

    # Buffer ops take 32-bit offsets from a base pointer; the lowering guards
    # that one (batch, head) slice of Q/K/V fits.
    Q = Q + off_zq * stride_qz + off_hq * stride_qh
    K = K + off_zkv * stride_kz + off_hkv * stride_kh
    V = V + off_zkv * stride_vz + off_hkv * stride_vh

    SPARSE_Z = {{size("KV_NUM_BLKS", 0)}}
    SPARSE_HQ = {{size("KV_NUM_BLKS", 1)}}
    SPARSE_Q_MULTIPLE: gl.constexpr = SPARSE_Q_BLOCK_SIZE // BLOCK_M
    SPARSE_KV_MULTIPLE: gl.constexpr = SPARSE_KV_BLOCK_SIZE // BLOCK_N
    sparse_hz_offset = (off_zq % SPARSE_Z) * SPARSE_HQ + off_hq % SPARSE_HQ
    sparse_q_block = q_start // SPARSE_Q_MULTIPLE

    offs_m = q_start * BLOCK_M + gl.arange(0, BLOCK_M, layout=ROW)
    q_offs_m = q_start * BLOCK_M + gl.arange(0, BLOCK_M, layout=gl.SliceLayout(1, Q_DOT))
    q_offs_d = gl.arange(0, HEAD_DIM, layout=gl.SliceLayout(0, Q_DOT))
    q_offsets = (q_offs_m[:, None] * stride_qm + q_offs_d[None, :]).to(gl.int32)
    if IS_DIVISIBLE:
        q = gl.amd.cdna4.buffer_load(Q, q_offsets)
    else:
        q = gl.amd.cdna4.buffer_load(Q, q_offsets, mask=q_offs_m[:, None] < Q_LEN, other=0.0)
    if PRESCALE_QK:
        q = (q * SM_SCALE * RCP_LN2).to(Q.dtype.element_ty)

    kv_offs_n = gl.arange(0, BLOCK_N, layout=gl.SliceLayout(1, LOAD))
    kv_offs_d = gl.arange(0, HEAD_DIM, layout=gl.SliceLayout(0, LOAD))
    k_smem = gl.allocate_shared_memory(K.dtype.element_ty, [BLOCK_N, HEAD_DIM], K_SMEM)
    v_smem = gl.allocate_shared_memory(V.dtype.element_ty, [BLOCK_N, HEAD_DIM], V_SMEM)

    m_i = gl.full([BLOCK_M], float("-inf"), gl.float32, layout=ROW)
    l_i = gl.full([BLOCK_M], 0.0, gl.float32, layout=ROW)
    acc = gl.zeros([BLOCK_M, HEAD_DIM], gl.float32, layout=MFMA)

    m = offs_m[:, None]
    if not IS_DIVISIBLE:
        m = m % Q_LEN
{%- for is_full_blocks in ([False, True] if HAS_FULL_BLOCKS else [False]) %}
{%- set prefix = "FULL_" if is_full_blocks else "" %}

    # ~~~~~~~~~~~~~~ {{ "full blocks: score_mod only" if is_full_blocks else "partial blocks: score_mod and mask_mod" }} ~~~~~~~~~~~~~~
    kv_indices = {{prefix}}KV_IDX + sparse_hz_offset * {{stride(prefix ~ "KV_IDX", 1)}} + sparse_q_block * {{stride(prefix ~ "KV_IDX", 2)}}
    kv_num_blocks = gl.load({{prefix}}KV_NUM_BLKS + sparse_hz_offset * {{stride(prefix ~ "KV_NUM_BLKS", 1)}} + sparse_q_block)
    kv_start = gl.load(kv_indices) * SPARSE_KV_BLOCK_SIZE
    block_n_end = gl.minimum(kv_num_blocks * SPARSE_KV_MULTIPLE, gl.maximum((KV_LEN + BLOCK_N - 1) // BLOCK_N, 1))

    for start_n in range(0, block_n_end):
        load_n = kv_start + kv_offs_n
        k_offsets = (load_n[:, None] * stride_kn + kv_offs_d[None, :]).to(gl.int32)
        v_offsets = (load_n[:, None] * stride_vn + kv_offs_d[None, :]).to(gl.int32)
        if IS_DIVISIBLE:
            gl.amd.cdna4.async_copy.buffer_load_to_shared(k_smem, K, k_offsets)
            gl.amd.cdna4.async_copy.commit_group()
            gl.amd.cdna4.async_copy.buffer_load_to_shared(v_smem, V, v_offsets)
            gl.amd.cdna4.async_copy.commit_group()
        else:
            load_mask = load_n[:, None] < KV_LEN
            gl.amd.cdna4.async_copy.buffer_load_to_shared(k_smem, K, k_offsets, mask=load_mask, other=0.0)
            gl.amd.cdna4.async_copy.commit_group()
            gl.amd.cdna4.async_copy.buffer_load_to_shared(v_smem, V, v_offsets, mask=load_mask, other=0.0)
            gl.amd.cdna4.async_copy.commit_group()

        gl.amd.cdna4.async_copy.wait_group(1)
        k = k_smem.permute([1, 0]).load(K_DOT)
        qk = gl.amd.cdna4.mfma(q, k, gl.zeros([BLOCK_M, BLOCK_N], gl.float32, layout=MFMA))
        if not PRESCALE_QK:
            qk *= SM_SCALE

        offs_n = kv_start + gl.arange(0, BLOCK_N, layout=COL)
        n = offs_n[None, :]
        if not IS_DIVISIBLE:
            n = n % KV_LEN
        {{ modification(
            subgraph_number=0,
            output_name="post_mod_scores",
            score="qk",
            b="off_zq",
            h="off_hq",
            m="m",
            n="n",
            out="qk",
            input_shapes={
                "score": ("BLOCK_M", "BLOCK_N"),
                "m": ("BLOCK_M", "1"),
                "n": ("1", "BLOCK_N"),
            },
            input_dtypes={"b": "index", "h": "index", "m": "index", "n": "index"},
        ) | indent_except_first(2) }}
        if not IS_DIVISIBLE:
            post_mod_scores = gl.where(offs_n[None, :] < KV_LEN, post_mod_scores, float("-inf"))
{%- if not is_full_blocks %}
        {{ modification(
            subgraph_number=1,
            output_name="mask_mod_output",
            score="qk",
            b="off_zq",
            h="off_hq",
            m="m",
            n="n",
            input_shapes={
                "score": ("BLOCK_M", "BLOCK_N"),
                "m": ("BLOCK_M", "1"),
                "n": ("1", "BLOCK_N"),
            },
            input_dtypes={"b": "index", "h": "index", "m": "index", "n": "index"},
        ) | indent_except_first(2) }}
        post_mod_scores = gl.where(mask_mod_output, post_mod_scores, float("-inf"))
{%- endif %}
        if not PRESCALE_QK:
            post_mod_scores *= RCP_LN2

        m_ij = gl.maximum(m_i, gl.max(post_mod_scores, 1))
        if not ROWS_GUARANTEED_SAFE:
            m_ij_masked = gl.where(m_ij == float("-inf"), 0.0, m_ij)
        else:
            m_ij_masked = m_ij
        alpha = gl.exp2(m_i - m_ij_masked)
        p = gl.exp2(post_mod_scores - m_ij_masked[:, None])
        l_i = l_i * alpha + gl.sum(p, 1)
        acc = acc * alpha[:, None]
        p = gl.convert_layout(p.to(V.dtype.element_ty), P_DOT)

        gl.amd.cdna4.async_copy.wait_group(0)
        v = v_smem.load(V_DOT)
        acc = gl.amd.cdna4.mfma(p, v, acc)
        m_i = m_ij

        kv_start += get_offset_for_next_block(
            start_n, kv_indices, kv_num_blocks, SPARSE_KV_BLOCK_SIZE, SPARSE_KV_MULTIPLE, BLOCK_N, BLOCKS_ARE_CONTIGUOUS
        )
{%- endfor %}

    # Fully masked rows have l_i == 0 and m_i == -inf; l_i = 1 makes out = 0 and lse = -inf.
    l_i = gl.where(l_i == 0.0, 1.0, l_i)
    acc = acc / l_i[:, None]

    idx_zq = off_zq
    idx_hq = off_hq
    idx_m = offs_m[:, None]
    idx_d = gl.arange(0, HEAD_DIM, layout=COL)[None, :]
    mask = (idx_m < Q_LEN) & (idx_d < V_HEAD_DIM)
    {{store_output(("idx_zq", "idx_hq", "idx_m", "idx_d"), "acc", "mask", val_shape=("BLOCK_M", "V_HEAD_DIM"))}}

    off_hz = off_zq * HQ + off_hq
    if OUTPUT_LOGSUMEXP:
        lse = m_i + gl.log2(l_i)
        if IS_DIVISIBLE:
            gl.store(LSE + off_hz * Q_LEN + offs_m, lse)
        else:
            gl.store(LSE + off_hz * Q_LEN + offs_m, lse, mask=offs_m < Q_LEN)
    if OUTPUT_MAX:
        if IS_DIVISIBLE:
            gl.store(MAX + off_hz * Q_LEN + offs_m, m_i)
        else:
            gl.store(MAX + off_hz * Q_LEN + offs_m, m_i, mask=offs_m < Q_LEN)


@gluon.constexpr_function
def padded_shared_layout(operand_layout, shape, dtype, is_k_contig):
    # Keep only the padding of the CDNA4 layout, not its swizzle: the swizzle
    # makes the LDS write stride non-affine, which async_copy cannot lower.
    layout = gl.amd.cdna4.compute_efficient_padded_shared_layout(
        operand_layout, shape, dtype, is_k_contig=is_k_contig
    )
    ((interval, padding),) = layout.interval_padding_pairs
    return gl.PaddedSharedLayout.with_identity_for([[int(interval), int(padding)]], shape, [1, 0])


@gluon.jit
def get_offset_for_next_block(
    loop_iter, col_indices, total_blocks,
    SPARSE_BLOCK, SPARSE_BLOCK_MULTIPLE, BLOCK,
    BLOCKS_ARE_CONTIGUOUS: gl.constexpr
):
    if BLOCKS_ARE_CONTIGUOUS:
        return BLOCK
    cur_block_idx = loop_iter // SPARSE_BLOCK_MULTIPLE
    cur_block = gl.load(col_indices + cur_block_idx)
    next_block = gl.load(col_indices + cur_block_idx + 1, mask=cur_block_idx + 1 < total_blocks)
    needs_jump = (loop_iter + 1) % SPARSE_BLOCK_MULTIPLE == 0
    jump_to_block = (next_block - cur_block) * SPARSE_BLOCK - (SPARSE_BLOCK_MULTIPLE - 1) * BLOCK
    return jump_to_block * needs_jump + (1 - needs_jump) * BLOCK
